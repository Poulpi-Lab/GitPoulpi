# TEMPLATE, NOT PUBLISHED. see the release-and-packaging design ("AUR").
#
# AUR package built from the official release archive (no compilation). Before publishing:
#   - replace @VERSION@ and @SHA256_LINUX_X86_64@ (the first field of the release's
#     gitpoulpi-<version>-x86_64-unknown-linux-gnu.tar.gz.sha256) and the Maintainer line;
#   - the repository must be public (makepkg downloads the archive anonymously);
#   - regenerate .SRCINFO, which the AUR requires next to the PKGBUILD:
#       makepkg --printsrcinfo > .SRCINFO
#     and check the build in a clean chroot (`extra-x86_64-build` from devtools) or with `makepkg -si`.
#
# A `.gitpoulpi-dist` marker with channel=aur is installed next to the programs: GitPoulpi then knows an AUR
# helper owns the updates (the chip shows `yay -S gitpoulpi-bin`) and never replaces its own files.
# @SHA256_LINUX_AARCH64@ is the same for the aarch64 archive.

# Maintainer: @MAINTAINER@
pkgname=gitpoulpi-bin
pkgver=@VERSION@
pkgrel=1
pkgdesc="Git client for the terminal with a clickable commit graph, a command palette, hosting integrations, a CLI and an MCP server"
arch=('x86_64' 'aarch64')
url="https://github.com/Poulpi-Lab/GitPoulpi"
license=('MIT')
# The release binaries link glibc, libgcc_s, libm and zlib dynamically; libgit2, rustls and Lua are built in.
depends=('git' 'zlib' 'gcc-libs' 'glibc')
optdepends=('git-lfs: repositories that use Git LFS (3.0 or newer)')
provides=('gitpoulpi')
conflicts=('gitpoulpi' 'gitpoulpi-git')
# The release binaries are already stripped; there is nothing to split into a debug package.
options=('!strip' '!debug')
source_x86_64=("https://github.com/Poulpi-Lab/GitPoulpi/releases/download/releases/v${pkgver}/gitpoulpi-${pkgver}-x86_64-unknown-linux-gnu.tar.gz")
source_aarch64=("https://github.com/Poulpi-Lab/GitPoulpi/releases/download/releases/v${pkgver}/gitpoulpi-${pkgver}-aarch64-unknown-linux-gnu.tar.gz")
sha256sums_x86_64=('@SHA256_LINUX_X86_64@')
sha256sums_aarch64=('@SHA256_LINUX_AARCH64@')

package() {
    local _target="${CARCH}-unknown-linux-gnu"
    cd "gitpoulpi-${pkgver}-${_target}"
    # Programs and marker live together in /usr/lib/gitpoulpi, /usr/bin holds symlinks. The marker says
    # channel=aur, so GitPoulpi shows the helper command for an update and never swaps files behind pacman.
    local bin
    for bin in gitpoulpi gitpoulpi-tui gitpoulpi-mcp gitpoulpi-launch gitpoulpi-updater; do
        install -Dm755 "${bin}" "${pkgdir}/usr/lib/gitpoulpi/${bin}"
    done
    for bin in gitpoulpi gitpoulpi-tui gitpoulpi-mcp gitpoulpi-launch; do
        install -d "${pkgdir}/usr/bin"
        ln -s "/usr/lib/gitpoulpi/${bin}" "${pkgdir}/usr/bin/${bin}"
    done
    printf 'version=%s\ntarget=%s\nchannel=aur\n' "${pkgver}" "${_target}" > "${srcdir}/gitpoulpi-dist-marker"
    install -Dm644 "${srcdir}/gitpoulpi-dist-marker" "${pkgdir}/usr/lib/gitpoulpi/.gitpoulpi-dist"
    install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
    install -Dm644 THIRD-PARTY-LICENSES.txt "${pkgdir}/usr/share/licenses/${pkgname}/THIRD-PARTY-LICENSES.txt"
    install -Dm644 README.md CHANGELOG.md INSTALL.txt -t "${pkgdir}/usr/share/doc/${pkgname}/"
}
